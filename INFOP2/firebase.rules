rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user';
    }

    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // People collection
    match /people/{document=**} {
      allow read, write: if isAdmin();
      allow read: if isUser();
    }

    // Assets collection
    match /assets/{document=**} {
      allow read, write: if isAdmin();
      allow read: if isUser();
    }

    // Categories collection and its items subcollection
    match /categories/{categoryId} {
      allow read, write: if isAdmin();
      allow read: if isUser();
      match /items/{itemId} {
        allow read, write: if isAdmin();
        allow read: if isUser();
      }
    }

    // Drivers collection
    match /drivers/{driverId} {
      allow read, write: if isAdmin();
      allow read: if isUser();
    }

    // Transport events collection
    match /transport_events/{eventId} {
      allow read, write: if isAdmin();
      allow read: if isUser();
    }

    // Persons collection
    match /persons/{personId} {
      allow read, write: if isAdmin();
      allow read: if isUser();
    }

    // Transactions collection
    match /transactions/{document=**} {
      allow read, write: if isAdmin();
      allow read: if isUser();
    }

    // Prayer events collection
    match /prayer_events/{eventId} {
      allow read, write: if isAdmin();
      allow read: if isUser();
    }
  }
} 