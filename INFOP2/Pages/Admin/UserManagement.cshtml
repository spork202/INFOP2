@page
@model INFOP2.Pages.Admin.UserManagementModel
@using Microsoft.AspNetCore.Authorization
@{
    ViewData["Title"] = "User Management";
    Layout = "../Shared/_Layout.cshtml";
}

<div class="card shadow rounded-4 mt-4">
    <div class="card-header bg-primary text-white d-flex align-items-center">
        <i class="fa-solid fa-users-gear me-2"></i>
        <span class="fw-bold">User Management</span>
    </div>
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by email..." />
                <button type="submit" class="btn btn-outline-secondary">Search</button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(Model.GlobalMessage))
        {
            <div class="alert alert-success mb-3">@Model.GlobalMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger mb-3">@Model.ErrorMessage</div>
        }
        <table class="table table-bordered table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model.FilteredUsers)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>
                        <span class="badge @(user.Role == "Admin" ? "bg-success" : "bg-secondary")">@user.Role</span>
                        <form method="post" asp-page-handler="ChangeRole" class="d-inline ms-2">
                            <input type="hidden" name="email" value="@user.Email" />
                            <select name="newRole" class="form-select d-inline w-auto">
                                <option value="User" selected="@(user.Role == "User" ? "selected" : null)">User</option>
                                <option value="Admin" selected="@(user.Role == "Admin" ? "selected" : null)">Admin</option>
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary ms-2">Update</button>
                        </form>
                        @if (Model.StatusMessages.TryGetValue(user.Email, out var msg))
                        {
                            <span class="text-success ms-2">@msg</span>
                        }
                    </td>
                    <td>
                        <form method="post" asp-page-handler="DeleteUser" onsubmit="return confirm('Are you sure you want to delete this user?');" class="d-inline">
                            <input type="hidden" name="email" value="@user.Email" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div> 